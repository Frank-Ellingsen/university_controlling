{
  "name": "University Tufte Minimalist Theme",
  "dataColors": [
    "#334155",
    "#64748b",
    "#94a3b8",
    "#0284c7",
    "#10b981",
    "#f59e0b",
    "#ef4444",
    "#475569"
  ],
  "background": "#FFFFFF",
  "foreground": "#0F172A",
  "tableAccent": "#334155",
  "visualStyles": {
    "*": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "subTitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "gridHorizontalWeight": 1
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold",
            "backColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            }
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "gridHorizontalWeight": 1
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#0F172A"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold",
            "backColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "legend": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#F1F5F9"
              }
            }
          }
        ]
      }
    }
  }
}