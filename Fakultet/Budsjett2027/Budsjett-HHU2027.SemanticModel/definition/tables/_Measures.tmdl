table _Measures
	lineageTag: 13e10f70-a66e-4fd0-bdc1-d569b36b6eee

	/// Samlet budsjettert inntekt (positive tall, MNOK)
	measure 'Budsjett Inntekt' =
			CALCULATE(
			    -SUM('FactBudget_2027'[BudsjettBelop]),
			    'DimAccountHierarchy'[Kontotype] = "Inntekt"
			)
		formatString: #,##0.0
		displayFolder: 01 Økonomi & Resultat
		lineageTag: c83f10dc-c48e-4c18-b1a2-aa4046981c39

	/// Samlede budsjetterte driftskostnader (positive tall, MNOK)
	measure 'Budsjett Kostnad' =
			CALCULATE(
			    SUM('FactBudget_2027'[BudsjettBelop]),
			    'DimAccountHierarchy'[Kontotype] = "Kostnad"
			)
		formatString: #,##0.0
		displayFolder: 01 Økonomi & Resultat
		lineageTag: a1c8bad7-48f3-41bd-bacb-14d1d9bceeb8

	/// Netto budsjettert driftsresultat (Inntekt minus Kostnad, MNOK)
	measure 'Budsjett Netto Resultat' = [Budsjett Inntekt] - [Budsjett Kostnad]
		formatString: +#,##0.0;-#,##0.0;0.0
		displayFolder: 01 Økonomi & Resultat
		lineageTag: fc17fb43-d8fe-4dd7-b5f7-cddb69036585

	/// Budsjettert lønnskostnad fast og midlertidig ansatte (MNOK)
	measure 'Budsjett Lønn' =
			CALCULATE(
			    SUM('FactBudget_2027'[BudsjettBelop]),
			    'DimAccountHierarchy'[Nivaa1_Navn] = "Lønnskostnad"
			)
		formatString: #,##0.0
		displayFolder: 01 Økonomi & Resultat
		lineageTag: f6328c88-d795-4b80-bb80-73efc2df4e36

	/// Budsjetterte andre driftskostnader inkl. husleie, IKT og konsulenter (MNOK)
	measure 'Budsjett Drift' =
			CALCULATE(
			    SUM('FactBudget_2027'[BudsjettBelop]),
			    'DimAccountHierarchy'[SRS_regnskapslinje] = "Andre driftskostnader"
			)
		formatString: #,##0.0
		displayFolder: 01 Økonomi & Resultat
		lineageTag: f8006b24-ee7a-4689-92c0-036e7c6a6405

	/// Budsjetterte ordinære avskrivninger inventar og IKT etter SRS 17 (MNOK)
	measure 'Budsjett Avskrivninger' =
			CALCULATE(
			    SUM('FactBudget_2027'[BudsjettBelop]),
			    'DimAccountHierarchy'[SRS_regnskapslinje] = "Av- og nedskrivninger"
			)
		formatString: #,##0.0
		displayFolder: 01 Økonomi & Resultat
		lineageTag: ef4cadf7-578f-4cad-9ae1-97acdec4fac5

	/// Statlig basis- og resultatbevilgning over statsbudsjettets Kap. 260 Post 50 (MNOK)
	measure 'Budsjett Bevilgning (KD)' =
			CALCULATE(
			    -SUM('FactBudget_2027'[BudsjettBelop]),
			    'DimAccountHierarchy'[Konto] = 3900
			)
		formatString: #,##0.0
		displayFolder: 01 Økonomi & Resultat
		lineageTag: c603ae5b-f30c-4003-9ec8-13c70c8eeb61

	/// Eksternfinansierte BOA- og EVU-inntekter etter SRS 9 og SRS 10 (MNOK)
	measure 'Budsjett BOA & EVU Inntekt' =
			CALCULATE(
			    -SUM('FactBudget_2027'[BudsjettBelop]),
			    'DimAccountHierarchy'[Konto] IN {3400, 3600, 3030}
			)
		formatString: #,##0.0
		displayFolder: 01 Økonomi & Resultat
		lineageTag: 1a32a643-9722-4355-bef2-9e3618a4e97d

	/// Lønnskostnadenes andel av samlede driftskostnader (Sektornorm: 62 - 65 %)
	measure 'Lønnsandel %' = DIVIDE([Budsjett Lønn], [Budsjett Kostnad])
		formatString: 0.0 %
		displayFolder: 01 Økonomi & Resultat
		lineageTag: 31a1c874-8327-4231-8577-385d7df12051

	/// Driftskostnadenes andel av samlede kostnader
	measure 'Driftsandel %' = DIVIDE([Budsjett Drift], [Budsjett Kostnad])
		formatString: 0.0 %
		displayFolder: 01 Økonomi & Resultat
		lineageTag: bf4785bc-28d9-4b2a-a7bc-516ad13bf421

	/// Driftsmargin i prosent av samlet inntekt
	measure 'Driftsmargin %' = DIVIDE([Budsjett Netto Resultat], [Budsjett Inntekt])
		formatString: 0.0 %
		displayFolder: 01 Økonomi & Resultat
		lineageTag: 681e4c22-b932-4a17-88a2-948d45ca34ed

	/// Totale normerte årsverk (Full-Time Equivalent)
	measure 'FTE Årsverk' =
			AVERAGEX(
			    VALUES('DimDate_2027'[AarMaaned]),
			    CALCULATE(SUM('FactFTE_2027'[Aarsverk]))
			)
		formatString: #,##0.0
		displayFolder: 02 Bemanningsstyring (FTE)
		lineageTag: 2e82f9d9-c166-49cf-8bd5-b0c41380c092

	/// Vitenskapelige årsverk innen undervisning og forskning (UF)
	measure UF-Årsverk =
			CALCULATE(
			    [FTE Årsverk],
			    'FactFTE_2027'[Stillingstype] = "UF"
			)
		formatString: #,##0.0
		displayFolder: 02 Bemanningsstyring (FTE)
		lineageTag: 300752ca-4ce9-4f51-999f-1542dffd5ce1

	/// Teknisk-administrative årsverk (TA)
	measure TA-Årsverk =
			CALCULATE(
			    [FTE Årsverk],
			    'FactFTE_2027'[Stillingstype] = "TA"
			)
		formatString: #,##0.0
		displayFolder: 02 Bemanningsstyring (FTE)
		lineageTag: 3b4e4e5a-1081-487d-9c27-958de094d4f3

	/// Totalt antall ansatte personer
	measure 'Antall Ansatte' =
			AVERAGEX(
			    VALUES('DimDate_2027'[AarMaaned]),
			    CALCULATE(SUM('FactFTE_2027'[AntallAnsatte]))
			)
		formatString: #,##0
		displayFolder: 02 Bemanningsstyring (FTE)
		lineageTag: e6469016-f9c7-46a9-a350-2e34c2eb4999

	/// Ubesatte stillinger / vakante årsverk
	measure 'Vakanser (Årsverk)' =
			AVERAGEX(
			    VALUES('DimDate_2027'[AarMaaned]),
			    CALCULATE(SUM('FactFTE_2027'[Vakanser]))
			)
		formatString: #,##0.0
		displayFolder: 02 Bemanningsstyring (FTE)
		lineageTag: d3480c1b-d4f2-4ac8-a0cc-4a606506a12f

	/// Vakanser i prosent av totale årsverk (vakansfaktor)
	measure 'Vakansfaktor %' = DIVIDE([Vakanser (Årsverk)], [FTE Årsverk])
		formatString: 0.0 %
		displayFolder: 02 Bemanningsstyring (FTE)
		lineageTag: af00c45d-fbc1-434e-8b5d-4f073f23c77a

	/// Gjennomsnittlig årslønn for vitenskapelig ansatte (NOK)
	measure 'Snittlønn UF (NOK)' =
			CALCULATE(
			    AVERAGEX(VALUES('DimDate_2027'[AarMaaned]), CALCULATE(AVERAGE('FactFTE_2027'[SnittLonnNOK]))),
			    'FactFTE_2027'[Stillingstype] = "UF"
			)
		formatString: #,##0
		displayFolder: 02 Bemanningsstyring (FTE)
		lineageTag: 532c30b1-bf66-4c00-acba-cfb65f0c32b0

	/// Gjennomsnittlig årslønn for teknisk-administrative ansatte (NOK)
	measure 'Snittlønn TA (NOK)' =
			CALCULATE(
			    AVERAGEX(VALUES('DimDate_2027'[AarMaaned]), CALCULATE(AVERAGE('FactFTE_2027'[SnittLonnNOK]))),
			    'FactFTE_2027'[Stillingstype] = "TA"
			)
		formatString: #,##0
		displayFolder: 02 Bemanningsstyring (FTE)
		lineageTag: 19ee9dee-4391-4952-9e1d-9c15ada0fbd0

	/// Samlet snittlønn på tvers av alle stillingsgrupper (NOK)
	measure 'Snittlønn Totalt (NOK)' =
			AVERAGEX(
			    VALUES('DimDate_2027'[AarMaaned]),
			    CALCULATE(AVERAGE('FactFTE_2027'[SnittLonnNOK]))
			)
		formatString: #,##0
		displayFolder: 02 Bemanningsstyring (FTE)
		lineageTag: edd81e26-bbd0-48cc-93d2-776e5d847961

	/// Totalt antall semesterregistrerte studenter i Felles Studentsystem (FS)
	measure 'Registrerte Studenter' = SUM('FactStudents_2027'[RegistrerteStudenter])
		formatString: #,##0
		displayFolder: 03 Utdanningsproduksjon & KD
		lineageTag: 92300141-ad9a-4db1-93b2-58f3d0b493fa

	/// Historisk studiepoengproduksjon 2025 som danner grunnlag for 2027-tildeling (2-års etterslep)
	measure 'SPE60 2025 Lag' = SUM('FactStudents_2027'[SPE60_2025_Lag])
		formatString: #,##0.0
		displayFolder: 03 Utdanningsproduksjon & KD
		lineageTag: a0958ca0-d7a3-4c5a-ac65-e39592023d13

	/// Måltall for studiepoengproduksjon i 2027 (SPE60 Target)
	measure 'SPE60 2027 Target' = SUM('FactStudents_2027'[SPE60_2027_Target])
		formatString: #,##0.0
		displayFolder: 03 Utdanningsproduksjon & KD
		lineageTag: f07c2080-0d9d-4869-b5e3-d82645893b77

	/// Forventet vekst i studiepoengproduksjon fra 2025-grunnlag til 2027-mål
	measure 'SPE60 Produksjonsvekst' = [SPE60 2027 Target] - [SPE60 2025 Lag]
		formatString: +#,##0.0;-#,##0.0;0.0
		displayFolder: 03 Utdanningsproduksjon & KD
		lineageTag: 10f98358-cc58-47a8-ac3a-985eaffcedec

	/// Prosentvis produksjonsvekst i studiepoeng
	measure 'SPE60 Vekst %' = DIVIDE([SPE60 Produksjonsvekst], [SPE60 2025 Lag])
		formatString: 0.0 %
		displayFolder: 03 Utdanningsproduksjon & KD
		lineageTag: 745298ba-1958-45e9-a49b-aefedecda6db

	/// Beregnet resultatbasert KD-tildeling etter KDs 2025/2027-modell (MNOK)
	measure 'Beregnet KD Inntekt (MNOK)' = DIVIDE(SUM('FactStudents_2027'[KDInntektBeregnetNOK]), 1000000)
		formatString: #,##0.0
		displayFolder: 03 Utdanningsproduksjon & KD
		lineageTag: 3a554c0f-e0c1-48ca-92ce-15962e83d6f8

	/// Lærertetthet målt som registrerte studenter per vitenskapelig årsverk
	measure 'Studenter per UF' = DIVIDE([Registrerte Studenter], [UF-Årsverk])
		formatString: 0.0
		displayFolder: 03 Utdanningsproduksjon & KD
		lineageTag: 7b56c174-ec81-416a-abd9-033cbdb3062f

	/// Studiepoengproduksjon per vitenskapelig årsverk (SPE60 per UF)
	measure 'SPE60 per UF' = DIVIDE([SPE60 2027 Target], [UF-Årsverk])
		formatString: 0.0
		displayFolder: 03 Utdanningsproduksjon & KD
		lineageTag: 3c7069b5-72c4-4be4-b5e2-ca79f0244e41

	/// Drifts- og personalkostnad per produserte 60 studiepoeng (tusen kroner)
	measure 'Enhetskostnad per SPE60 (kNOK)' = DIVIDE([Budsjett Kostnad] * 1000, [SPE60 2027 Target])
		formatString: #,##0
		displayFolder: 03 Utdanningsproduksjon & KD
		lineageTag: 9b39cdb8-9248-4aaa-b491-ef8001e5f38c

	/// Vedtatt innsparingseffekt i omstillingsplan (MNOK)
	measure 'Planlagt Innsparing (MNOK)' = SUM('FactAction_2027'[ForventetEffektMNOK])
		formatString: #,##0.0
		displayFolder: 04 Omstillingstiltak & EVM
		lineageTag: 8176ef57-acb9-4697-902b-588c60a5233d

	/// Realisert innsparingseffekt per dags dato (MNOK)
	measure 'Realisert Innsparing (MNOK)' = SUM('FactAction_2027'[RealisertEffektMNOK])
		formatString: #,##0.0
		displayFolder: 04 Omstillingstiltak & EVM
		lineageTag: 4262e572-5b13-418e-93f1-b206e6d8d6c6

	/// Realiseringsgrad for vedtatte omstillingstiltak
	measure 'Realiseringsgrad %' = DIVIDE([Realisert Innsparing (MNOK)], [Planlagt Innsparing (MNOK)])
		formatString: 0.0 %
		displayFolder: 04 Omstillingstiltak & EVM
		lineageTag: dade3b27-99f9-4e8e-bbc0-64810ba2ecfd

	/// Antall vedtatte omstillingstiltak i handlingsplan
	measure 'Antall Tiltak' = COUNTROWS('FactAction_2027')
		formatString: 0
		displayFolder: 04 Omstillingstiltak & EVM
		lineageTag: d8613752-b169-4425-84f4-c576ab90a2a6

	/// Avsetning til formålskapital i henhold til F-05-20 (MNOK)
	measure 'F-05-20 Avsetningsreserve (MNOK)' = [Budsjett Netto Resultat]
		formatString: +#,##0.0;-#,##0.0;0.0
		displayFolder: 04 Omstillingstiltak & EVM
		lineageTag: c85c3b87-5657-4cf2-b1d4-bc503c210563

	/// Formålskapitalavsetningens andel av samlet bevilgning (5 %-regelen i F-05-20)
	measure 'F-05-20 Avsetningsandel %' = DIVIDE([F-05-20 Avsetningsreserve (MNOK)], [Budsjett Bevilgning (KD)])
		formatString: 0.0 %
		displayFolder: 04 Omstillingstiltak & EVM
		lineageTag: 20d23890-aafb-4be9-b718-88386c568e50

	/// Trafikklys RAG-status for netto rammeresultat
	measure 'RAG Netto Resultat' = IF([Budsjett Netto Resultat] >= 0, "🟢 Overskudd", "🔴 Underskudd")
		displayFolder: 05 RAG & Formatering
		lineageTag: 2590ba69-7aea-4fb6-9460-5cc12a32781d

	/// Trafikklys RAG-status for lønnsandel i forhold til sektornorm på 62 - 65 %
	measure 'RAG Lønnsandel' = IF([Lønnsandel %] <= 0.65, "🟢 Innenfor norm", "🟡 Høy lønnsandel")
		displayFolder: 05 RAG & Formatering
		lineageTag: 21f42b3d-fdd4-4c13-b70a-789ee4213140

	/// Trafikklys RAG-status for F-05-20 avsetningsgrense på maksimalt 5 %
	measure 'RAG F-05-20 Status' = IF([F-05-20 Avsetningsandel %] <= 0.05, "🟢 < 5% Formålskapital", "🔴 Risiko for inndragning")
		displayFolder: 05 RAG & Formatering
		lineageTag: 25deb4a4-4fb5-4e37-aa8e-8271fef7de93

	/// Strategisk controller-diagnose og driveranalyse per enhet
	measure 'Diagnose og Drivere 2027' =
			VAR Org = SELECTEDVALUE('DimOrganization'[OrgKode])
			RETURN
			SWITCH(
			    Org,
			    1110, "HHU Ledelse & Innovasjon: 100,4 MNOK inntekt / +3,0 MNOK overskudd. T003 EVU-ekspansjon (-1,4 MNOK). 22,7 stud/UF.",
			    1120, "HHU Rettsvitenskap: 71,7 MNOK inntekt / +2,2 MNOK overskudd. Juss-profesjon. 21,3 stud/UF. Lav vakansgrad.",
			    1130, "HHU Økonomi: 86,0 MNOK inntekt / +2,6 MNOK overskudd. T002 omdisponering av 5 faglige årsverk (-3,05 MNOK).",
			    1140, "HHU Fakultetsadministrasjon: 28,7 MNOK inntekt / +0,86 MNOK overskudd. T001 ansettelsesstopp TA (-1,8 MNOK).",
			    1200, "TEK: 351 MNOK inntekt. Ingeniør- og realfag. Kategori 2 sats (81 800 kr/SPE60). 14,0 stud/UF.",
			    1300, "HEL: 310 MNOK inntekt. Helsefag og sykepleie. Kategori 2 sats. 15,9 stud/UF.",
			    1400, "SAM: 242 MNOK inntekt. Samfunnsvitenskap. Kategori 1 sats. 20,2 stud/UF.",
			    1500, "HUM: 201 MNOK inntekt. Lærerutdanning og humaniora. Kategori 1 sats. 20,2 stud/UF.",
			    1600, "ADM: Sentral fellesadministrasjon og fellesdrift. T004 rammeavtaler og lisenskutt (-1,2 MNOK).",
			    "Handelshøyskolen ved UiA (HHU) har et samlet vedtatt budsjett på 286,8 MNOK inntekt, 278,2 MNOK kostnad og et netto driftsoverskudd på +8,6 MNOK."
			)
		displayFolder: 05 RAG & Formatering
		lineageTag: cc0d5846-c2bc-4037-b2d7-3dd11ad83871

	column RowId
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 4cfe6379-f2c6-4060-999c-855c42168422
		summarizeBy: none
		sourceColumn: RowId

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i45WMlSKjQUA", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [RowId = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"RowId", Int64.Type}}, "en-US")
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

