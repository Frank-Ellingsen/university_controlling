// University of Agder (UiA) - Enterprise & Project Controlling DAX Measure Library
// Author: Frank Ellingsen (Financial & Project Controller)
// Standard: Edward Tufte Data-Ink Principles | Norwegian SRS & KD Accounting Model
// ==============================================================================

// ------------------------------------------------------------------------------
// Folder: _01 Regnskap & YTD (Financial Performance pr. 30.09.2026)
// ------------------------------------------------------------------------------

Actual YTD = 
CALCULATE(
    SUM('FactGL'[Belop_signert_MNOK]),
    'FactGL'[VersjonKode] = "ACTUAL_YTD_SEP2026"
)

Budsjett YTD = 
CALCULATE(
    SUM('FactBudget'[Budsjett_signert_MNOK]),
    'DimDate'[StatusPr30Sep] = "Actual"
)

Avvik YTD = 
[Actual YTD] - [Budsjett YTD]

Avvik YTD % = 
DIVIDE([Avvik YTD], ABS([Budsjett YTD]), 0)


// ------------------------------------------------------------------------------
// Folder: _02 Prognose & EAC (Forecasting & Estimate at Completion)
// ------------------------------------------------------------------------------

Forecast Q4 = 
CALCULATE(
    SUM('FactGL'[Belop_signert_MNOK]),
    'FactGL'[VersjonKode] = "FC_Q4_2026"
)

Forecast LE (EAC) = 
[Actual YTD] + [Forecast Q4]

Årsbudsjett (BAC) = 
SUM('FactBudget'[Budsjett_signert_MNOK])

Sluttavvik (VAC) = 
[Årsbudsjett (BAC)] - [Forecast LE (EAC)]

VAC % = 
DIVIDE([Sluttavvik (VAC)], ABS([Årsbudsjett (BAC)]), 0)


// ------------------------------------------------------------------------------
// Folder: _03 EVM (Earned Value Management & Project Control)
// ------------------------------------------------------------------------------

Planned Value (PV) = 
SUM('FactEVM'[Planned_Value_PV_MNOK])

Earned Value (EV) = 
SUM('FactEVM'[Earned_Value_EV_MNOK])

Actual Cost (AC) = 
SUM('FactEVM'[Actual_Cost_AC_MNOK])

Cost Variance (CV) = 
[Earned Value (EV)] - [Actual Cost (AC)]

Cost Variance (CV) % = 
DIVIDE([Cost Variance (CV)], [Earned Value (EV)], 0)

Schedule Variance (SV) = 
[Earned Value (EV)] - [Planned Value (PV)]

Schedule Variance (SV) % = 
DIVIDE([Schedule Variance (SV)], [Planned Value (PV)], 0)

CPI = 
DIVIDE([Earned Value (EV)], [Actual Cost (AC)], 1)

SPI = 
DIVIDE([Earned Value (EV)], [Planned Value (PV)], 1)

EAC (EVM) = 
DIVIDE([Årsbudsjett (BAC)], [CPI], [Årsbudsjett (BAC)])

VAC (EVM) = 
[Årsbudsjett (BAC)] - [EAC (EVM)]

TCPI (To-Complete Performance Index) = 
DIVIDE(
    [Årsbudsjett (BAC)] - [Earned Value (EV)],
    [Årsbudsjett (BAC)] - [Actual Cost (AC)],
    1
)


// ------------------------------------------------------------------------------
// Folder: _04 Bemanning & FTE (Staffing & Capacity KPIs)
// ------------------------------------------------------------------------------

Totale Årsverk = 
CALCULATE(
    SUM('FactFTE'[Aarsverk_Faktisk]),
    'DimDate'[DatoNokkel] = MAX('FactFTE'[DatoNokkel])
)

Faglige Årsverk (UF) = 
CALCULATE(
    SUM('FactFTE'[Aarsverk_UF]),
    'DimDate'[DatoNokkel] = MAX('FactFTE'[DatoNokkel])
)

Teknisk-Admin Årsverk (TA) = 
CALCULATE(
    SUM('FactFTE'[Aarsverk_TA]),
    'DimDate'[DatoNokkel] = MAX('FactFTE'[DatoNokkel])
)

Faglig Andel % = 
DIVIDE([Faglige Årsverk (UF)], [Totale Årsverk], 0)

Faglig Mål % = 
0.60

Årsverk Avvik fra Mål = 
([Totale Årsverk] * 0.60) - [Faglige Årsverk (UF)]


// ------------------------------------------------------------------------------
// Folder: _05 Utdanning & Studiepoeng (Student & Production KPIs)
// ------------------------------------------------------------------------------

Registrerte Studenter = 
SUM('FactStudents'[Registrerte_Studenter])

Avlagte SPE60 = 
SUM('FactStudents'[SPE60_Helarsstudenter])

Studenter pr UF-Årsverk = 
DIVIDE([Registrerte Studenter], [Faglige Årsverk (UF)], 0)

SPE60 pr Student = 
DIVIDE([Avlagte SPE60], [Registrerte Studenter], 0)

Enhetskostnad pr SPE60 = 
DIVIDE([Forecast LE (EAC)] * 1000000, [Avlagte SPE60], 0)

KD Resultatbevilgning MNOK = 
VAR Kat1 = SUM('FactStudents'[KD_Kategori1_SPE60]) * 54550
VAR Kat2 = SUM('FactStudents'[KD_Kategori2_SPE60]) * 81800
VAR Kat3 = SUM('FactStudents'[KD_Kategori3_SPE60]) * 190900
RETURN DIVIDE(Kat1 + Kat2 + Kat3, 1000000, 0)


// ------------------------------------------------------------------------------
// Folder: _06 Scorecard & KPI (Universal Disconnected Metric Measures)
// ------------------------------------------------------------------------------

Scorecard KPI Verdi = 
SWITCH(
    SELECTEDVALUE('DimKPI'[KPI_ID]),
    1, [Actual YTD],
    2, [Budsjett YTD],
    3, [Avvik YTD],
    4, [Avvik YTD %],
    5, [Forecast LE (EAC)],
    6, [Årsbudsjett (BAC)],
    7, [Sluttavvik (VAC)],
    8, [VAC %],
    9, [Planned Value (PV)],
    10, [Earned Value (EV)],
    11, [Actual Cost (AC)],
    12, [CPI],
    13, [SPI],
    14, [Totale Årsverk],
    15, [Faglige Årsverk (UF)],
    16, [Teknisk-Admin Årsverk (TA)],
    17, [Faglig Andel %],
    18, [Registrerte Studenter],
    19, [Avlagte SPE60],
    20, [Studenter pr UF-Årsverk],
    21, [Enhetskostnad pr SPE60],
    22, [KD Resultatbevilgning MNOK],
    BLANK()
)

Scorecard KPI Budsjett = 
SWITCH(
    SELECTEDVALUE('DimKPI'[KPI_ID]),
    1, [Budsjett YTD],
    5, [Årsbudsjett (BAC)],
    9, [Planned Value (PV)],
    10, [Planned Value (PV)],
    11, [Planned Value (PV)],
    12, 1.0,
    13, 1.0,
    17, 0.60,
    BLANK()
)

Scorecard KPI Avvik = 
SWITCH(
    SELECTEDVALUE('DimKPI'[KPI_ID]),
    1, [Avvik YTD],
    3, [Avvik YTD],
    4, [Avvik YTD %],
    5, [Sluttavvik (VAC)],
    7, [Sluttavvik (VAC)],
    8, [VAC %],
    10, [Cost Variance (CV)],
    11, [Cost Variance (CV)],
    12, [CPI] - 1.0,
    13, [SPI] - 1.0,
    17, [Faglig Andel %] - 0.60,
    BLANK()
)

Scorecard KPI RAG Status = 
VAR KpiId = SELECTEDVALUE('DimKPI'[KPI_ID])
RETURN
SWITCH(
    TRUE(),
    KpiId IN {1, 3, 5, 7},
        IF([Sluttavvik (VAC)] >= 0, "🟢 Under/I budsjett",
            IF([VAC %] >= -0.05, "🟡 Moderat overskridelse (< 5%)", "🔴 Kritisk overskridelse (> 5%)")),
    KpiId = 12,
        IF([CPI] >= 1.0, "🟢 Kostnadseffektiv (>= 1.0)",
            IF([CPI] >= 0.95, "🟡 Moderat avvik", "🔴 Kostnadsoverskridelse")),
    KpiId = 13,
        IF([SPI] >= 1.0, "🟢 I rute (>= 1.0)",
            IF([SPI] >= 0.95, "🟡 Moderat forsinket", "🔴 Kritisk forsinket")),
    KpiId = 17,
        IF([Faglig Andel %] >= 0.60, "🟢 Mål nådd (>= 60%)", "🟡 Under måltall (< 60%)"),
    "⚪ Nøytral"
)


// ------------------------------------------------------------------------------
// Folder: _07 RAG & Betinget Formatering (Conditional Formatting & Hex Codes)
// ------------------------------------------------------------------------------

Forecast RAG Status = 
IF([Sluttavvik (VAC)] >= 0, "🟢 Under/I budsjett",
    IF([VAC %] >= -0.05, "🟡 Moderat overskridelse (< 5%)",
        "🔴 Kritisk overskridelse (> 5%)"
    )
)

RAG Hex Color = 
IF([Sluttavvik (VAC)] >= 0, "#10b981", // Emerald Green
    IF([VAC %] >= -0.05, "#f59e0b", // Amber Warning
        "#ef4444" // Crimson Alert
    )
)

CPI RAG Status = 
IF([CPI] >= 1.0, "🟢 Effektiv (>= 1.0)",
    IF([CPI] >= 0.95, "🟡 Moderat avvik",
        "🔴 Kostnadsoverskridelse"
    )
)

SPI RAG Status = 
IF([SPI] >= 1.0, "🟢 I rute (>= 1.0)",
    IF([SPI] >= 0.95, "🟡 Moderat forsinket",
        "🔴 Kritisk forsinket"
    )
)

CPI Hex Color = 
IF([CPI] >= 1.0, "#10b981",
    IF([CPI] >= 0.95, "#f59e0b",
        "#ef4444"
    )
)

SPI Hex Color = 
IF([SPI] >= 1.0, "#10b981",
    IF([SPI] >= 0.95, "#f59e0b",
        "#ef4444"
    )
)

Avvik YTD Hex Color = 
IF([Avvik YTD] <= 0, "#10b981",
    IF([Avvik YTD %] <= 0.05, "#f59e0b",
        "#ef4444"
    )
)

BOA Inntekt (NFR/EU) = 
CALCULATE(
    SUM('FactGL'[Belop_signert_MNOK]),
    'DimAccountHierarchy'[Nivaa2_Kontogruppe] = "34",
    'FactGL'[VersjonKode] = "ACTUAL_YTD_SEP2026"
)

Vakanser (Ubesatte stillinger) = 
CALCULATE(
    SUM('FactFTE'[Ubesatte_Vakanser]),
    'DimDate'[DatoNokkel] = MAX('FactFTE'[DatoNokkel])
)

Ubenyttede Midler % = 
DIVIDE(MAX(0, [Sluttavvik (VAC)]), [Årsbudsjett (BAC)], 0)

5% Avsetningsgrense (F-05-20) = 
[Årsbudsjett (BAC)] * 0.05

5% Regel Status = 
IF([Ubenyttede Midler %] <= 0.05, "🟢 Innenfor 5% (F-05-20)", "🔴 Risiko for inndragning (>5%)")

Aktiv Enhet = 
IF(
    HASONEVALUE('DimOrganization'[Enhet]),
    SELECTEDVALUE('DimOrganization'[Enhet]),
    "Universitetet i Agder (Alle enheter)"
)

Aktiv Leder = 
IF(
    HASONEVALUE('DimOrganization'[Leder_Tittel]),
    SELECTEDVALUE('DimOrganization'[Leder_Tittel]),
    "Universitetsledelsen / Rektorat"
)

