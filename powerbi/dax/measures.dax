Lønnsandel % = 
CALCULATE(
    DIVIDE(
        SUM('FactFacultyKPI'[Lonnskostnader_MNOK]),
        SUM('FactFacultyKPI'[Total_Kostnad_MNOK]),
        0.654
    ),
    'FactFacultyKPI'[OrgKode] <> 1000
)

Lønnsandel Sektormål % = 0.710

Omstilling Planlagt MNOK = -15.0

Omstilling Realisert MNOK = -9.0

Omstilling Udekket Gap = 2.0

