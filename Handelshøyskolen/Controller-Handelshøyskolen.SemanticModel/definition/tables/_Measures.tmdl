table _Measures
	lineageTag: 9d07dc51-2881-4e4a-b681-f3cc97a23da1

	/// Actual YTD (Bokført regnskap M01 - M09 / Sept 30 Cutoff)
	measure 'Actual YTD' =
			CALCULATE(
			    SUM('FactGL'[Belop_signert]),
			    'FactGL'[Bokforingstype] = "Actual"
			)
		formatString: #,##0.0
		displayFolder: _01 Accounting
		description: "Actual YTD (Bokført regnskap M01 - M09 / Sept 30 Cutoff) | Actual YTD summerer bokførte hovedboksbevegelser frem til 30. september (1 072,1 MNOK inntekt / 1 092,0 MNOK kostnader for UiA)."
		lineageTag: f6035ce0-e1e7-4c65-9c23-3108adfe59f2

	/// Budsjett YTD (Akkumulert periodisert budsjett M01 - M09)
	measure 'Budsjett YTD' =
			CALCULATE(
			    SUM('FactBudget'[BudsjettBelop]),
			    'DimDate'[ErActualYTD] = TRUE()
			)
		formatString: #,##0.0
		displayFolder: _01 Accounting
		description: "Budsjett YTD (Akkumulert periodisert budsjett M01 - M09) | Actual YTD summerer bokførte hovedboksbevegelser frem til 30. september (1 072,1 MNOK inntekt / 1 092,0 MNOK kostnader for UiA)."
		lineageTag: 016fa028-679f-43b5-9658-e82d971aa183

	/// Avvik YTD (MNOK) [Positivt = Merforbruk / Negativt = Mindreforbruk]
	measure 'Avvik YTD' =
			[Actual YTD] - [Budsjett YTD]
		formatString: #,##0.0
		displayFolder: _01 Accounting
		description: "Avvik YTD (MNOK) [Positivt = Merforbruk / Negativt = Mindreforbruk] | Actual YTD summerer bokførte hovedboksbevegelser frem til 30. september (1 072,1 MNOK inntekt / 1 092,0 MNOK kostnader for UiA)."
		lineageTag: 8840fd54-26f3-4ef1-bc36-23e20cb6a09f

	/// Avvik YTD %
	measure 'Avvik YTD %' =
			DIVIDE([Avvik YTD], [Budsjett YTD], 0)
		formatString: 0.0%
		displayFolder: _01 Accounting
		description: "Avvik YTD % | Actual YTD summerer bokførte hovedboksbevegelser frem til 30. september (1 072,1 MNOK inntekt / 1 092,0 MNOK kostnader for UiA)."
		lineageTag: 6dc16d93-270c-4e31-92d5-6b548b8b000a

	/// Monthly Actuals and Forecast Bridge (M01-M09 Actuals + M10-M12 Q4 Forecast)
	measure 'Monthly Actuals and Forecast' =
			VAR CutoffMonth = 9
			VAR CurrentMonth = MAX('DimDate'[MaanedNummer])
			VAR ActualAmount = CALCULATE(SUM('FactGL'[Belop_signert]), 'FactGL'[Bokforingstype] = "Actual")
			VAR ForecastAmount = CALCULATE(SUM('FactGL'[Belop_signert]), 'FactGL'[Bokforingstype] = "Forecast")
			RETURN
			IF(CurrentMonth <= CutoffMonth, ActualAmount, ForecastAmount)
		formatString: #,##0.0
		displayFolder: _01 Accounting
		description: "Monthly Actuals and Forecast Bridge (M01-M09 Actuals + M10-M12 Q4 Forecast) | Actual YTD summerer bokførte hovedboksbevegelser frem til 30. september (1 072,1 MNOK inntekt / 1 092,0 MNOK kostnader for UiA)."
		lineageTag: f2a2cf1c-2357-4418-a19c-1cd773baed2f

	/// Forecast Q4 / Estimate to Complete (ETC M10 - M12)
	measure 'Forecast Q4 (ETC)' =
			CALCULATE(
			    SUM('FactGL'[Belop_signert]),
			    'FactGL'[Bokforingstype] = "Forecast"
			)
		formatString: #,##0.0
		displayFolder: _02 Forecast & LE
		description: "Forecast Q4 / Estimate to Complete (ETC M10 - M12) | Samlet helårsprognose (Forecast LE / EAC) utgjør 1 433,0 MNOK inntekt mot 1 444,0 MNOK kostnader. Netto helårsavvik (VAC) på -11,0 MNOK dekkes av oppsparte reserver i tråd med Note 15 og Rundskriv F-05-20."
		lineageTag: 6ef296a6-ad62-48c1-8680-ff4ef33764aa

	/// Forecast LE / Estimate at Completion (EAC = Actual YTD + Q4 Forecast)
	measure 'Forecast LE (EAC)' =
			[Actual YTD] + [Forecast Q4 (ETC)]
		formatString: #,##0.0
		displayFolder: _02 Forecast & LE
		description: "Forecast LE / Estimate at Completion (EAC = Actual YTD + Q4 Forecast) | Samlet helårsprognose (Forecast LE / EAC) utgjør 1 433,0 MNOK inntekt mot 1 444,0 MNOK kostnader. Netto helårsavvik (VAC) på -11,0 MNOK dekkes av oppsparte reserver i tråd med Note 15 og Rundskriv F-05-20."
		lineageTag: c1347f40-e9d2-4b6a-975a-e68b2182f7ef

	/// Vedtatt Årsbudsjett / Budget at Completion (BAC)
	measure 'Årsbudsjett (BAC)' =
			SUM('FactBudget'[BudsjettBelop])
		formatString: #,##0.0
		displayFolder: _02 Forecast & LE
		description: "Vedtatt Årsbudsjett / Budget at Completion (BAC) | Samlet helårsprognose (Forecast LE / EAC) utgjør 1 433,0 MNOK inntekt mot 1 444,0 MNOK kostnader. Netto helårsavvik (VAC) på -11,0 MNOK dekkes av oppsparte reserver i tråd med Note 15 og Rundskriv F-05-20."
		lineageTag: 2580146d-5cd7-416b-ab96-9bdaf7f3449e

	/// Sluttavvik / Variance at Completion (VAC MNOK = BAC - EAC)
	measure 'Sluttavvik (VAC)' =
			[Årsbudsjett (BAC)] - [Forecast LE (EAC)]
		formatString: #,##0.0
		displayFolder: _02 Forecast & LE
		description: "Sluttavvik / Variance at Completion (VAC MNOK = BAC - EAC) | Samlet helårsprognose (Forecast LE / EAC) utgjør 1 433,0 MNOK inntekt mot 1 444,0 MNOK kostnader. Netto helårsavvik (VAC) på -11,0 MNOK dekkes av oppsparte reserver i tråd med Note 15 og Rundskriv F-05-20."
		lineageTag: 61bb73a4-3e8d-40bf-8099-751dc19f4b4b

	/// VAC % (Relativ overskridelse eller innsparing)
	measure 'VAC %' =
			DIVIDE([Sluttavvik (VAC)], [Årsbudsjett (BAC)], 0)
		formatString: 0.0%
		displayFolder: _02 Forecast & LE
		description: "VAC % (Relativ overskridelse eller innsparing) | Samlet helårsprognose (Forecast LE / EAC) utgjør 1 433,0 MNOK inntekt mot 1 444,0 MNOK kostnader. Netto helårsavvik (VAC) på -11,0 MNOK dekkes av oppsparte reserver i tråd med Note 15 og Rundskriv F-05-20."
		lineageTag: 0d8d3c66-faf7-41f3-849c-6cdd1bb35602

	/// Prior Year Actuals (PY YTD)
	measure 'Actual PY' =
			CALCULATE(
			    [Actual YTD],
			    SAMEPERIODLASTYEAR('DimDate'[Dato])
			)
		formatString: #,##0.0
		displayFolder: _03 Temporal YoY & MoM
		description: "Prior Year Actuals (PY YTD) | Temporære sammenligningslinjer (YoY og MoM) sikrer at ledelsen evaluerer driftsmomentum parallelt med faste årsbudsjetter."
		lineageTag: cbf17100-ff2c-4da1-a9d7-0a17b39fc7d1

	/// Absolute Year-over-Year Difference (YoY MNOK)
	measure 'Actual YoY' =
			[Actual YTD] - [Actual PY]
		formatString: #,##0.0
		displayFolder: _03 Temporal YoY & MoM
		description: "Absolute Year-over-Year Difference (YoY MNOK) | Temporære sammenligningslinjer (YoY og MoM) sikrer at ledelsen evaluerer driftsmomentum parallelt med faste årsbudsjetter."
		lineageTag: 0fda8e86-6d7b-4d34-9e58-72ec4f4ef009

	/// Percentage Year-over-Year Growth (YoY %)
	measure 'Actual YoY %' =
			DIVIDE([Actual YoY], [Actual PY], 0)
		formatString: 0.0%
		displayFolder: _03 Temporal YoY & MoM
		description: "Percentage Year-over-Year Growth (YoY %) | Temporære sammenligningslinjer (YoY og MoM) sikrer at ledelsen evaluerer driftsmomentum parallelt med faste årsbudsjetter."
		lineageTag: 175a49c2-4bb1-40c3-ab42-90e21a2665a7

	/// Prior Month Actuals (PM)
	measure 'Actual PM' =
			CALCULATE(
			    SUM('FactGL'[Belop_signert]),
			    PREVIOUSMONTH('DimDate'[Dato]),
			    'FactGL'[Bokforingstype] = "Actual"
			)
		formatString: #,##0.0
		displayFolder: _03 Temporal YoY & MoM
		description: "Prior Month Actuals (PM) | Temporære sammenligningslinjer (YoY og MoM) sikrer at ledelsen evaluerer driftsmomentum parallelt med faste årsbudsjetter."
		lineageTag: 561107dc-e44d-42ec-ae9a-de9ed4eae3d5

	/// Current Month Actuals (CM)
	measure 'Actual CM' =
			CALCULATE(
			    SUM('FactGL'[Belop_signert]),
			    'DimDate'[DatoNokkel] = MAX('FactGL'[DatoNokkel]),
			    'FactGL'[Bokforingstype] = "Actual"
			)
		formatString: #,##0.0
		displayFolder: _03 Temporal YoY & MoM
		description: "Current Month Actuals (CM) | Temporære sammenligningslinjer (YoY og MoM) sikrer at ledelsen evaluerer driftsmomentum parallelt med faste årsbudsjetter."
		lineageTag: 4615dcdd-daaf-47cd-bd27-6b154db2fa88

	/// Month-over-Month Difference (MoM MNOK)
	measure 'Actual MoM' =
			[Actual CM] - [Actual PM]
		formatString: #,##0.0
		displayFolder: _03 Temporal YoY & MoM
		description: "Month-over-Month Difference (MoM MNOK) | Temporære sammenligningslinjer (YoY og MoM) sikrer at ledelsen evaluerer driftsmomentum parallelt med faste årsbudsjetter."
		lineageTag: d36c359a-ef95-420a-9a48-0c00c0b2aa02

	/// Percentage Month-over-Month Growth (MoM %)
	measure 'Actual MoM %' =
			DIVIDE([Actual MoM], [Actual PM], 0)
		formatString: 0.0%
		displayFolder: _03 Temporal YoY & MoM
		description: "Percentage Month-over-Month Growth (MoM %) | Temporære sammenligningslinjer (YoY og MoM) sikrer at ledelsen evaluerer driftsmomentum parallelt med faste årsbudsjetter."
		lineageTag: a5929f01-56b1-4743-9411-7da4853d3bd1

	/// Planned Value (PV) - Akkumulert planlagt verdi
	measure 'Planned Value (PV)' =
			SUM('FactEVM'[Planned_Value_PV_MNOK])
		formatString: #,##0.0
		displayFolder: _04 EVM
		description: "Planned Value (PV) - Akkumulert planlagt verdi | Ved T3-avskjæring er UiAs CPI 0,95 (5% kostnadsoverskridelse) og SPI 0,92 (8% fremdriftsforsinkelse)."
		lineageTag: 91da2db5-85b3-4acb-8579-4c4d0fbbe32a

	/// Earned Value (EV) - Akkumulert opptjent verdi
	measure 'Earned Value (EV)' =
			SUM('FactEVM'[Earned_Value_EV_MNOK])
		formatString: #,##0.0
		displayFolder: _04 EVM
		description: "Earned Value (EV) - Akkumulert opptjent verdi | Ved T3-avskjæring er UiAs CPI 0,95 (5% kostnadsoverskridelse) og SPI 0,92 (8% fremdriftsforsinkelse)."
		lineageTag: 8f6482e1-5a0f-45da-92bf-998667e4f39f

	/// Actual Cost (AC) - Akkumulert faktisk kostnad
	measure 'Actual Cost (AC)' =
			SUM('FactEVM'[Actual_Cost_AC_MNOK])
		formatString: #,##0.0
		displayFolder: _04 EVM
		description: "Actual Cost (AC) - Akkumulert faktisk kostnad | Ved T3-avskjæring er UiAs CPI 0,95 (5% kostnadsoverskridelse) og SPI 0,92 (8% fremdriftsforsinkelse)."
		lineageTag: 6f790d72-62f4-43ea-94b1-1aff325b508a

	/// Cost Performance Index (CPI = EV / AC)
	measure 'CPI' =
			DIVIDE([Earned Value (EV)], [Actual Cost (AC)], 1)
		formatString: 0.00
		displayFolder: _04 EVM
		description: "Cost Performance Index (CPI = EV / AC) | Ved T3-avskjæring er UiAs CPI 0,95 (5% kostnadsoverskridelse) og SPI 0,92 (8% fremdriftsforsinkelse)."
		lineageTag: 80acbcd5-728d-4b66-81a9-81204b1542ff

	/// Schedule Performance Index (SPI = EV / PV)
	measure 'SPI' =
			DIVIDE([Earned Value (EV)], [Planned Value (PV)], 1)
		formatString: 0.00
		displayFolder: _04 EVM
		description: "Schedule Performance Index (SPI = EV / PV) | Ved T3-avskjæring er UiAs CPI 0,95 (5% kostnadsoverskridelse) og SPI 0,92 (8% fremdriftsforsinkelse)."
		lineageTag: f1fcadc0-5e6b-4ca2-a775-64274b85cc08

	/// EVM Status Subtitle Callout
	measure 'EVM Status Subtitle' =
			VAR CPIVal = [CPI]
			VAR SPIVal = [SPI]
			RETURN
			"CPI: " & FORMAT(CPIVal, "0.00") & " (Kost) | SPI: " & FORMAT(SPIVal, "0.00") & " (Fremdrift)"
		displayFolder: _04 EVM
		description: "EVM Status Subtitle Callout | Ved T3-avskjæring er UiAs CPI 0,95 (5% kostnadsoverskridelse) og SPI 0,92 (8% fremdriftsforsinkelse)."
		lineageTag: 9e08d1c4-c0a6-4ef7-a362-5b28bec366a6

	/// Totale Årsverk (FTE Snapshot)
	measure 'Totale Årsverk' =
			CALCULATE(
			    SUM('FactFTE'[Aarsverk]),
			    'DimDate'[DatoNokkel] = MAX('FactFTE'[DatoNokkel])
			)
		formatString: #,##0.0
		displayFolder: _05 Staffing & FTE
		description: "Totale Årsverk (FTE Snapshot) | Lønnskostnader utgjør 65,4% av totale driftskostnader ved UiA (944,0 MNOK), marginalt over sektornormens øvre terskel på 65,0%."
		lineageTag: 20163a4d-6b6a-4776-ad13-72b2bd8c6529

	/// Faglige Årsverk (UF - Undervisning og Forskning)
	measure 'Faglige Årsverk (UF)' =
			CALCULATE(
			    [Totale Årsverk],
			    'FactFTE'[Stillingstype] = "UF"
			)
		formatString: #,##0.0
		displayFolder: _05 Staffing & FTE
		description: "Faglige Årsverk (UF - Undervisning og Forskning) | Lønnskostnader utgjør 65,4% av totale driftskostnader ved UiA (944,0 MNOK), marginalt over sektornormens øvre terskel på 65,0%."
		lineageTag: 2d4fdf92-94a4-4862-9875-38a570cde8da

	/// Teknisk-Administrative Årsverk (TA)
	measure 'Teknisk-Admin Årsverk (TA)' =
			CALCULATE(
			    [Totale Årsverk],
			    'FactFTE'[Stillingstype] = "TA"
			)
		formatString: #,##0.0
		displayFolder: _05 Staffing & FTE
		description: "Teknisk-Administrative Årsverk (TA) | Lønnskostnader utgjør 65,4% av totale driftskostnader ved UiA (944,0 MNOK), marginalt over sektornormens øvre terskel på 65,0%."
		lineageTag: 89fe4884-9fc9-4ebe-8968-9d48e2dc24e6

	/// Faglig Andel % (Sektormål: > 50-55%)
	measure 'Faglig Andel %' =
			DIVIDE([Faglige Årsverk (UF)], [Totale Årsverk], 0)
		formatString: 0.0%
		displayFolder: _05 Staffing & FTE
		description: "Faglig Andel % (Sektormål: > 50-55%) | Lønnskostnader utgjør 65,4% av totale driftskostnader ved UiA (944,0 MNOK), marginalt over sektornormens øvre terskel på 65,0%."
		lineageTag: b1cc55c9-36da-4aee-bf28-d6ffc199b26c

	/// Lønnsandel % av Totale Driftskostnader (Sektornorm: 62-65%)
	measure 'Lønnsandel %' =
			VAR Lonn = CALCULATE(SUM('FactGL'[Belop_signert]), 'DimAccountHierarchy'[Nivaa1_Navn] = "Lønnskostnad")
			VAR TotalKost = CALCULATE(SUM('FactGL'[Belop_signert]), 'DimAccountHierarchy'[Kontotype] = "Kostnad")
			RETURN DIVIDE(Lonn, TotalKost, 0)
		formatString: 0.0%
		displayFolder: _05 Staffing & FTE
		description: "Lønnsandel % av Totale Driftskostnader (Sektornorm: 62-65%) | Lønnskostnader utgjør 65,4% av totale driftskostnader ved UiA (944,0 MNOK), marginalt over sektornormens øvre terskel på 65,0%."
		lineageTag: 390757d1-bd98-4f8b-86e0-dbf346fe4f32

	/// Staffing Card Subtitle Callout
	measure 'Staffing Card Subtitle' =
			VAR UF = [Faglige Årsverk (UF)]
			VAR TA = [Teknisk-Admin Årsverk (TA)]
			VAR LonnPct = [Lønnsandel %]
			RETURN
			FORMAT(UF, "#0") & " UF / " & FORMAT(TA, "#0") & " TA | Lønnsandel: " & FORMAT(LonnPct, "0.0%")
		displayFolder: _05 Staffing & FTE
		description: "Staffing Card Subtitle Callout | Lønnskostnader utgjør 65,4% av totale driftskostnader ved UiA (944,0 MNOK), marginalt over sektornormens øvre terskel på 65,0%."
		lineageTag: 94353867-7cb3-4f5c-990e-153340e322fe

	/// Registrerte Studenter
	measure 'Registrerte Studenter' =
			SUM('FactStudents'[RegistrerteStudenter])
		formatString: #,##0
		displayFolder: _06 Utdanning & SPE60
		description: "Registrerte Studenter | Under KDs 2025-finansieringsmodell gir Kategori 1 en sats på 54 550 NOK pr 60 SPE. Satsen gjelder marginale volumendringer."
		lineageTag: b8cc44f6-f924-4b40-a41a-6f121175137c

	/// Avlagte Studiepoengekvivalenter (SPE60 = Total SP / 60)
	measure 'Avlagte SPE60' =
			SUM('FactStudents'[SPE60])
		formatString: #,##0
		displayFolder: _06 Utdanning & SPE60
		description: "Avlagte Studiepoengekvivalenter (SPE60 = Total SP / 60) | Under KDs 2025-finansieringsmodell gir Kategori 1 en sats på 54 550 NOK pr 60 SPE. Satsen gjelder marginale volumendringer."
		lineageTag: 307282a3-e9b0-4152-a541-b519236520e7

	/// Studenter pr Faglig Årsverk (Lærertetthet & Kapasitet)
	measure 'Studenter pr UF-Årsverk' =
			DIVIDE([Registrerte Studenter], [Faglige Årsverk (UF)], 0)
		formatString: #,##0.0
		displayFolder: _06 Utdanning & SPE60
		description: "Studenter pr Faglig Årsverk (Lærertetthet & Kapasitet) | Under KDs 2025-finansieringsmodell gir Kategori 1 en sats på 54 550 NOK pr 60 SPE. Satsen gjelder marginale volumendringer."
		lineageTag: 05a3778d-245b-4bcf-830f-b2756d1681b4

	/// Enhetskostnad pr SPE60 (NOK pr produserte helårsstudent)
	measure 'Enhetskostnad pr SPE60' =
			DIVIDE([Forecast LE (EAC)] * 1000000, [Avlagte SPE60], 0)
		formatString: #,##0.0
		displayFolder: _06 Utdanning & SPE60
		description: "Enhetskostnad pr SPE60 (NOK pr produserte helårsstudent) | Under KDs 2025-finansieringsmodell gir Kategori 1 en sats på 54 550 NOK pr 60 SPE. Satsen gjelder marginale volumendringer."
		lineageTag: 6988f95b-597b-4a71-a620-ac24628c3bc4

	/// KD Kategori 1 Inntekt (Humaniora, Samfunnsfag, Økonomi @ 54 550 kr/SPE60)
	measure 'KD Kat 1 Inntekt' =
			CALCULATE(
			    SUM('FactStudents'[SPE60]) * 54550,
			    'FactStudents'[KDKategori] = "Kategori 1"
			)
		formatString: #,##0.0
		displayFolder: _06 Utdanning & SPE60
		description: "KD Kategori 1 Inntekt (Humaniora, Samfunnsfag, Økonomi @ 54 550 kr/SPE60) | Under KDs 2025-finansieringsmodell gir Kategori 1 en sats på 54 550 NOK pr 60 SPE. Satsen gjelder marginale volumendringer."
		lineageTag: 2f4cc489-e2a1-4f03-af15-f8efb9a49ba9

	/// Student KPI Card Subtitle Callout
	measure 'Student KPI Subtitle' =
			VAR SPE = [Avlagte SPE60]
			VAR Ratio = [Studenter pr UF-Årsverk]
			RETURN
			FORMAT(SPE, "#,##0") & " SPE60 | " & FORMAT(Ratio, "0.0") & " Studenter/UF-ÅV"
		displayFolder: _06 Utdanning & SPE60
		description: "Student KPI Card Subtitle Callout | Under KDs 2025-finansieringsmodell gir Kategori 1 en sats på 54 550 NOK pr 60 SPE. Satsen gjelder marginale volumendringer."
		lineageTag: c252a630-2ea9-4ce0-ab8c-acc123846f1a

	/// Forventet Tiltakseffekt (Planlagt innsparing i MNOK)
	measure 'Forventet Tiltakseffekt' =
			SUM('FactAction'[ForventetEffekt])
		formatString: #,##0.0
		displayFolder: _07 Action Tracker
		description: "Forventet Tiltakseffekt (Planlagt innsparing i MNOK) | FactAction kobler omstillingstiltak (f.eks. administrativ ansettelsesstopp T001/T002) direkte til regnskapskonti og prognoseavvik."
		lineageTag: 00467edb-36d1-4793-bc13-e966b36e5fc3

	/// Realisert Tiltakseffekt (Bokført innsparing hittil)
	measure 'Realisert Tiltakseffekt' =
			SUM('FactAction'[RealisertEffekt])
		formatString: #,##0.0
		displayFolder: _07 Action Tracker
		description: "Realisert Tiltakseffekt (Bokført innsparing hittil) | FactAction kobler omstillingstiltak (f.eks. administrativ ansettelsesstopp T001/T002) direkte til regnskapskonti og prognoseavvik."
		lineageTag: f0fe25ba-51d7-4113-bffb-c86b204fc9ff

	/// Tiltak Realiseringsgrad %
	measure 'Tiltak Realiseringsgrad %' =
			DIVIDE([Realisert Tiltakseffekt], [Forventet Tiltakseffekt], 0)
		formatString: 0.0%
		displayFolder: _07 Action Tracker
		description: "Tiltak Realiseringsgrad % | FactAction kobler omstillingstiltak (f.eks. administrativ ansettelsesstopp T001/T002) direkte til regnskapskonti og prognoseavvik."
		lineageTag: 5120ad34-2b7d-4f56-b3f2-9b7be1d397fb

	/// Forecast etter Tiltak (Netto Sluttresultat inkl. omstilling)
	measure 'Forecast etter Tiltak' =
			[Forecast LE (EAC)] + [Forventet Tiltakseffekt]
		formatString: #,##0.0
		displayFolder: _07 Action Tracker
		description: "Forecast etter Tiltak (Netto Sluttresultat inkl. omstilling) | FactAction kobler omstillingstiltak (f.eks. administrativ ansettelsesstopp T001/T002) direkte til regnskapskonti og prognoseavvik."
		lineageTag: 29f35471-396c-486a-8cbf-fde7a8293baf

	/// Restavvik etter Tiltak (Gjenværende risikogap)
	measure 'Restavvik etter Tiltak' =
			[Forecast etter Tiltak] - [Årsbudsjett (BAC)]
		formatString: #,##0.0
		displayFolder: _07 Action Tracker
		description: "Restavvik etter Tiltak (Gjenværende risikogap) | FactAction kobler omstillingstiltak (f.eks. administrativ ansettelsesstopp T001/T002) direkte til regnskapskonti og prognoseavvik."
		lineageTag: 0ad63d06-4e6b-424e-b9fb-da1cfae7db6e

	/// Budget Variance RAG Status Text Badge
	measure 'Budget Variance RAG Status' =
			VAR Budget = [Årsbudsjett (BAC)]
			VAR Forecast = [Forecast LE (EAC)]
			VAR Vac = Forecast - Budget
			VAR VacPct = DIVIDE(Vac, Budget, 0)
			RETURN
			SWITCH(
			    TRUE(),
			    Vac >= 0, "🟢 Under/I budsjett",
			    VacPct >= -0.05, "🟡 Moderat overskridelse (2-5%)",
			    "🔴 Kritisk overskridelse (>5%)"
			)
		displayFolder: _08 RAG & Design
		description: "Budget Variance RAG Status Text Badge | Bruk av myke bakgrunnsfyll (#ECFDF5, #FFFBEB, #FEF2F2) forhindrer blendende neonfarger og følger Edward Tuftes data-ink prinsipper."
		lineageTag: 0b95c5c5-d577-465c-99ce-d7037c0af261

	/// Primary RAG Hex Color (For Bars, Card Accents & Text)
	measure 'RAG Hex Color' =
			VAR Vac = [Sluttavvik (VAC)]
			VAR VacPct = [VAC %]
			RETURN
			IF(
			    Vac >= 0, 
			    "#10b981", // Emerald Green
			    IF(
			        VacPct >= -0.05, 
			        "#f59e0b", // Amber Yellow
			        "#ef4444"  // Crimson Red
			    )
			)
		displayFolder: _08 RAG & Design
		description: "Primary RAG Hex Color (For Bars, Card Accents & Text) | Bruk av myke bakgrunnsfyll (#ECFDF5, #FFFBEB, #FEF2F2) forhindrer blendende neonfarger og følger Edward Tuftes data-ink prinsipper."
		lineageTag: 228277a9-9649-4673-befe-e90ae60bc2df

	/// Soft RAG Background Fill Hex (Tufte 85% Opacity Tint for Matrix Cells)
	measure 'RAG Soft Background Hex' =
			VAR Vac = [Sluttavvik (VAC)]
			VAR VacPct = [VAC %]
			RETURN
			IF(
			    Vac >= 0, 
			    "#ecfdf5", // Soft Mint Green
			    IF(
			        VacPct >= -0.05, 
			        "#fffbeb", // Soft Warm Amber
			        "#fef2f2"  // Soft Crimson Red
			    )
			)
		formatString: #,##0.0
		displayFolder: _08 RAG & Design
		description: "Soft RAG Background Fill Hex (Tufte 85% Opacity Tint for Matrix Cells) | Bruk av myke bakgrunnsfyll (#ECFDF5, #FFFBEB, #FEF2F2) forhindrer blendende neonfarger og følger Edward Tuftes data-ink prinsipper."
		lineageTag: 0b77ac02-01ab-4491-a278-69aafa9007f4

	/// Multi-Context Card Subtitle with RAG Icons (New Card Visual)
	measure 'Multi-Context Revenue Subtitle' =
			VAR Budget = [Årsbudsjett (BAC)]
			VAR Forecast = [Forecast LE (EAC)]
			VAR PlanDiffPct = DIVIDE(Forecast - Budget, Budget, 0)
			VAR YoYPct = [Actual YoY %]
			VAR MoMPct = [Actual MoM %]
			
			VAR PlanIcon = IF(PlanDiffPct >= 0, "🟢", IF(PlanDiffPct >= -0.05, "🟡", "🔴"))
			VAR YoYIcon = IF(YoYPct >= 0, "🟢", "🔴")
			
			VAR PlanText = PlanIcon & " Budsj: " & IF(PlanDiffPct >= 0, "▲ +", "▼ ") & FORMAT(PlanDiffPct, "0.0%")
			VAR YoYText = YoYIcon & " YoY: " & IF(YoYPct >= 0, "▲ +", "▼ ") & FORMAT(YoYPct, "0.0%")
			VAR MoMText = "MoM: " & IF(MoMPct >= 0, "▲ +", "▼ ") & FORMAT(MoMPct, "0.0%")
			
			RETURN
			PlanText & " | " & YoYText & " | " & MoMText
		displayFolder: _08 RAG & Design
		description: "Multi-Context Card Subtitle with RAG Icons (New Card Visual) | Bruk av myke bakgrunnsfyll (#ECFDF5, #FFFBEB, #FEF2F2) forhindrer blendende neonfarger og følger Edward Tuftes data-ink prinsipper."
		lineageTag: 812150fb-0d3b-4626-b364-7f8d2cbab660

	/// HHU Total Revenue (276.6 MNOK)
	measure 'HHU Total Revenue' =
			CALCULATE(
