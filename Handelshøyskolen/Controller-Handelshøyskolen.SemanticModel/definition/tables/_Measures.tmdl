		formatString: #,##0.0
		displayFolder: _09 HHU Measures
		description: "HHU Net Result (+2.2 MNOK Surplus) | Handelshøyskolen (HHU) leverer et positivt netto driftsresultat på +2,2 MNOK. Høy student-til-faglig ratio (22,3) kombinert med KD Kat 1 krever aktiv controller-oppfølging."
		lineageTag: 7ca7ec63-b4b1-4f66-a946-5d7ad3ee70e3

	/// HHU Lønnsandel % (65.4%)
	measure 'HHU Lønnsandel %' =
			CALCULATE(
			    [Lønnsandel %],
			    'DimOrganization'[Fakultetsnavn] = "Handelshøyskolen ved UiA (HHU)"
			)
		formatString: 0.0%
		displayFolder: _09 HHU Measures
		description: "HHU Lønnsandel % (65.4%) | Handelshøyskolen (HHU) leverer et positivt netto driftsresultat på +2,2 MNOK. Høy student-til-faglig ratio (22,3) kombinert med KD Kat 1 krever aktiv controller-oppfølging."
		lineageTag: 30b211ce-cd12-4da6-bd60-121f40590357

	/// HHU Studenter pr UF-Årsverk (22.3 Ratio)
	measure 'HHU Studenter pr UF-Årsverk' =
			VAR Studenter = CALCULATE(SUM('FactStudents'[RegistrerteStudenter]), 'DimOrganization'[Fakultetsnavn] = "Handelshøyskolen ved UiA (HHU)")
			VAR UF = CALCULATE(SUM('FactFTE'[Aarsverk]), 'DimOrganization'[Fakultetsnavn] = "Handelshøyskolen ved UiA (HHU)", 'FactFTE'[Stillingstype] = "UF")
			RETURN DIVIDE(Studenter, UF, 0)
		formatString: #,##0.0
		displayFolder: _09 HHU Measures
		description: "HHU Studenter pr UF-Årsverk (22.3 Ratio) | Handelshøyskolen (HHU) leverer et positivt netto driftsresultat på +2,2 MNOK. Høy student-til-faglig ratio (22,3) kombinert med KD Kat 1 krever aktiv controller-oppfølging."
		lineageTag: de3187d3-0ae7-4eb2-bf06-e718eb0e6be1

	/// HHU BOA Frikjøpsgrad (Buy-Out Share)
	measure 'HHU BOA Frikjøpsgrad' =
			VAR BOALonn = CALCULATE(SUM('FactGL'[Belop_signert]), 'DimOrganization'[Fakultetsnavn] = "Handelshøyskolen ved UiA (HHU)", 'DimAccountHierarchy'[Nivaa1_Navn] = "Lønnskostnad", 'DimOrganization'[Virksomhetstype] = "BOA")
			VAR TotalLonn = CALCULATE(SUM('FactGL'[Belop_signert]), 'DimOrganization'[Fakultetsnavn] = "Handelshøyskolen ved UiA (HHU)", 'DimAccountHierarchy'[Nivaa1_Navn] = "Lønnskostnad")
			RETURN DIVIDE(BOALonn, TotalLonn, 0)
		formatString: #,##0.0
		displayFolder: _09 HHU Measures
		description: "HHU BOA Frikjøpsgrad (Buy-Out Share) | Handelshøyskolen (HHU) leverer et positivt netto driftsresultat på +2,2 MNOK. Høy student-til-faglig ratio (22,3) kombinert med KD Kat 1 krever aktiv controller-oppfølging."
		lineageTag: e713cb96-bf10-4f93-aa80-5ae63d7f1bf1

	/// HHU RAG Status
	measure 'HHU RAG Status' =
			VAR Resultat = [HHU Net Result]
			RETURN
			IF(Resultat >= 0, "🟢 Overskudd (+2.2 MNOK / Ramme overholdt)",
			    IF(Resultat >= -2.0, "🟡 Moderat merforbruk (< 2 MNOK)", "🔴 Kritisk merforbruk (> 2 MNOK)")
			)
		displayFolder: _09 HHU Measures
		description: "HHU RAG Status | Handelshøyskolen (HHU) leverer et positivt netto driftsresultat på +2,2 MNOK. Høy student-til-faglig ratio (22,3) kombinert med KD Kat 1 krever aktiv controller-oppfølging."
