	/// Statuslinje inntekt
	measure 'Revenue Variance Indicator' =
			VAR Budget = [Årsbudsjett (BAC)] VAR Forecast = [Forecast LE (EAC)] VAR Diff = Forecast - Budget VAR Pct = DIVIDE(Diff, Budget, 0) RETURN "Budsjett: " & FORMAT(Budget, "#,##0.0") & " MNOK | " & IF(Diff >= 0, "▲ +" & FORMAT(Pct, "0.0%"), "▼ " & FORMAT(Pct, "0.0%"))
