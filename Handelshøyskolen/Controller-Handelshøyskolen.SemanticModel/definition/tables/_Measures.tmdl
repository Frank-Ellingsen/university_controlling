	/// Statuslinje resultat
	measure 'Net Result Status Text' =
			VAR YTDResult = [Actual YTD] VAR HelarVAC = [Sluttavvik (VAC)] RETURN "Helårsavvik: " & FORMAT(HelarVAC, "+#,##0.0;-#,##0.0;0.0") & " MNOK | YTD: " & FORMAT(YTDResult, "#,##0.0") & " MNOK"
