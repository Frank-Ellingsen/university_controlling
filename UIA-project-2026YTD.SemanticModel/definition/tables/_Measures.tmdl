			    DIVIDE(
			        SUM('FactFacultyKPI'[Lonnskostnader_MNOK]),
			        SUM('FactFacultyKPI'[Total_Kostnad_MNOK]),
			        0.654
			    ),
			    'FactFacultyKPI'[OrgKode] <> 1000
			)
		formatString: 0.0%
		displayFolder: _04 Bemanning & FTE
		lineageTag: d9a12359-0de1-43b4-8a30-4aff406f9687

	measure 'Lønnsandel Sektormål %' = 0.710
