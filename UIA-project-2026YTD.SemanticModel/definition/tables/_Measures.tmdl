		lineageTag: b8a12353-0de1-43b4-8a30-4aff406f9681

	measure 'Ubenyttede Midler %' = DIVIDE(MAX(0, [Sluttavvik (VAC)]), [Årsbudsjett (BAC)], 0)
		formatString: 0.0%
		displayFolder: _02 Prognose & EAC
		lineageTag: b8a12354-0de1-43b4-8a30-4aff406f9682

	measure '5% Avsetningsgrense (F-05-20)' = [Årsbudsjett (BAC)] * 0.05
