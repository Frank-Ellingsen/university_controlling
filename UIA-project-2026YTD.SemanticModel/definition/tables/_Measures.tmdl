table _Measures
	lineageTag: 53bbfafa-fa80-4cf9-a89d-30d0248c1aee

	measure 'Actual YTD' =
			CALCULATE(
			    SUM('FactGL'[Belop_signert_MNOK]),
			    'FactGL'[VersjonKode] = "ACTUAL_YTD_SEP2026"
			)
		formatString: #,##0.00
		displayFolder: _01 Regnskap & YTD
		lineageTag: c3fbaf22-88e9-4f86-a6be-7ea55c48d190

	measure 'Budsjett YTD' =
			CALCULATE(
			    SUM('FactBudget'[Budsjett_signert_MNOK]),
			    'DimDate'[StatusPr30Sep] = "Actual"
			)
		formatString: #,##0.00
		displayFolder: _01 Regnskap & YTD
		lineageTag: fb3f9dee-2a3a-47bb-841b-4f1d2fd15bc2

	measure 'Avvik YTD' = [Actual YTD] - [Budsjett YTD]
		formatString: #,##0.00
		displayFolder: _01 Regnskap & YTD
		lineageTag: 546a11cd-e92a-4981-90a1-b039b7ab7893

	measure 'Avvik YTD %' = DIVIDE([Avvik YTD], ABS([Budsjett YTD]), 0)
		formatString: 0.0%
		displayFolder: _01 Regnskap & YTD
		lineageTag: afd33959-e009-4b6d-89ea-f1493368ff04

	measure 'Forecast Q4' =
			CALCULATE(
			    SUM('FactGL'[Belop_signert_MNOK]),
			    'FactGL'[VersjonKode] = "FC_Q4_2026"
			)
		formatString: #,##0.00
		displayFolder: _02 Prognose & EAC
		lineageTag: a793c3b1-0bf0-4d3d-a5f1-6956adbd7c7c

	measure 'Forecast LE (EAC)' = [Actual YTD] + [Forecast Q4]
		formatString: #,##0.00
		displayFolder: _02 Prognose & EAC
		lineageTag: 6ac5faff-5a29-4e60-8e8a-ace8319dc64b

	measure 'Årsbudsjett (BAC)' = SUM('FactBudget'[Budsjett_signert_MNOK])
		formatString: #,##0.00
		displayFolder: _02 Prognose & EAC
		lineageTag: 0517c85c-ec01-454b-a01c-4570a3e462d3

	measure 'Sluttavvik (VAC)' = [Årsbudsjett (BAC)] - [Forecast LE (EAC)]
		formatString: #,##0.00
		displayFolder: _02 Prognose & EAC
		lineageTag: e717eedb-ed87-46a9-bf04-bad285d3b49a

	measure 'VAC %' = DIVIDE([Sluttavvik (VAC)], ABS([Årsbudsjett (BAC)]), 0)
		formatString: 0.0%
		displayFolder: _02 Prognose & EAC
		lineageTag: b9693502-c996-4259-99d8-11f809bb8413

	measure 'Planned Value (PV)' = SUM('FactEVM'[Planned_Value_PV_MNOK])
		formatString: #,##0.0
		displayFolder: _03 EVM
		lineageTag: b64cc2b5-0de1-43b4-8a30-4aff406f9672

	measure 'Earned Value (EV)' = SUM('FactEVM'[Earned_Value_EV_MNOK])
		formatString: #,##0.0
		displayFolder: _03 EVM
		lineageTag: d8dcba33-9bdc-420c-8458-800033dd1261

	measure 'Actual Cost (AC)' = SUM('FactEVM'[Actual_Cost_AC_MNOK])
		formatString: #,##0.0
		displayFolder: _03 EVM
		lineageTag: d0792e3f-67b7-42d9-8059-5b8ba4fcc26c

	measure CPI = DIVIDE([Earned Value (EV)], [Actual Cost (AC)], 1)
		formatString: 0.00
		displayFolder: _03 EVM
		lineageTag: 7a85ee1b-237b-4ca8-842b-73387db959de

	measure SPI = DIVIDE([Earned Value (EV)], [Planned Value (PV)], 1)
		formatString: 0.00
		displayFolder: _03 EVM
		lineageTag: 787cd3ea-e14d-49d0-a3bc-3f2f6904dd62

	measure 'Totale Årsverk' =
			CALCULATE(
			    SUM('FactFTE'[Aarsverk_Faktisk]),
			    'DimDate'[DatoNokkel] = MAX('FactFTE'[DatoNokkel])
			)
		formatString: #,##0.0
		displayFolder: _04 Bemanning & FTE
		lineageTag: 99f5d39e-7e2c-405d-baa6-68d7ca035d62

	measure 'Faglige Årsverk (UF)' =
			CALCULATE(
			    SUM('FactFTE'[Aarsverk_UF]),
			    'DimDate'[DatoNokkel] = MAX('FactFTE'[DatoNokkel])
			)
		formatString: #,##0.0
		displayFolder: _04 Bemanning & FTE
		lineageTag: 37a8ec97-23da-4037-a89b-5c1bd612216c

	measure 'Teknisk-Admin Årsverk (TA)' =
			CALCULATE(
			    SUM('FactFTE'[Aarsverk_TA]),
			    'DimDate'[DatoNokkel] = MAX('FactFTE'[DatoNokkel])
			)
		formatString: #,##0.0
		displayFolder: _04 Bemanning & FTE
		lineageTag: 7cb5b19c-51de-40e6-b622-fcb02330233e

	measure 'Faglig Andel %' = DIVIDE([Faglige Årsverk (UF)], [Totale Årsverk], 0)
		formatString: 0.0%
		displayFolder: _04 Bemanning & FTE
		lineageTag: d890e067-24a4-491f-b085-6afa979246f0

	measure 'Registrerte Studenter' = SUM('FactStudents'[Registrerte_Studenter])
		formatString: #,##0
		displayFolder: _05 Utdanning
		lineageTag: 199396a1-3e3e-47f5-81e7-d0bc61922626

	measure 'Avlagte SPE60' = SUM('FactStudents'[SPE60_Helarsstudenter])
		formatString: #,##0.0
		displayFolder: _05 Utdanning
		lineageTag: 6aab23ae-a227-4c5c-a708-c6cd3fb02cea

	measure 'Studenter pr UF-Årsverk' = DIVIDE([Registrerte Studenter], [Faglige Årsverk (UF)], 0)
		formatString: #,##0.0
		displayFolder: _05 Utdanning
		lineageTag: c6b7be62-efb8-42ce-b370-98d126583089

	measure 'Enhetskostnad pr SPE60' = DIVIDE([Forecast LE (EAC)] * 1000000, [Avlagte SPE60], 0)
		formatString: #,##0
		displayFolder: _05 Utdanning
		lineageTag: a207d887-1806-4553-9466-d1c3d983cbb1

	measure 'KD Resultatbevilgning MNOK' =
			VAR Kat1 = SUM('FactStudents'[KD_Kategori1_SPE60]) * 54550
			VAR Kat2 = SUM('FactStudents'[KD_Kategori2_SPE60]) * 81800
			VAR Kat3 = SUM('FactStudents'[KD_Kategori3_SPE60]) * 190900
			RETURN DIVIDE(Kat1 + Kat2 + Kat3, 1000000, 0)
		formatString: #,##0.00
		displayFolder: _05 Utdanning
		lineageTag: b1ac72eb-aab0-48b4-803e-9e4ca8e03d4e

	measure 'Forecast RAG Status' =
			IF([Sluttavvik (VAC)] >= 0, "🟢 Under/I budsjett",
			    IF([VAC %] >= -0.05, "🟡 Moderat overskridelse (< 5%)",
			        "🔴 Kritisk overskridelse (> 5%)"
			    )
			)
		displayFolder: _06 RAG & Design
		lineageTag: 39dd7285-be9b-4187-aae3-9d40c67805a3

	measure 'RAG Hex Color' =
			IF([Sluttavvik (VAC)] >= 0, "#10b981",
			    IF([VAC %] >= -0.05, "#f59e0b",
			        "#ef4444"
			    )
			)
		displayFolder: _06 RAG & Design
		lineageTag: b50da885-c3c0-4773-aec3-b4a63980d094

	column Column1
		dataType: string
		isHidden
		lineageTag: 4bf5fed7-64c3-4930-8595-6c0abff44d12
		summarizeBy: none
		sourceColumn: Column1

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t])
				in
				    Source

	annotation PBI_ResultType = Table

