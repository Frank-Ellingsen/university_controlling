table _Measures
	lineageTag: 25664629-a0c9-4850-9c45-4fa456b7afd3

	measure 'Actual YTD' =
			CALCULATE(
			    SUM('FactGL'[Belop_signert_MNOK]),
			    'FactGL'[VersjonKode] = "ACTUAL_YTD_SEP2026"
			)
		formatString: #,##0.00
		displayFolder: _01 Regnskap & YTD
		lineageTag: cc188bba-5bdc-472b-a0d1-b351ca07a8c2

	measure 'Budsjett YTD' =
			CALCULATE(
			    SUM('FactBudget'[Budsjett_signert_MNOK]),
			    'DimDate'[StatusPr30Sep] = "Actual"
			)
		formatString: #,##0.00
		displayFolder: _01 Regnskap & YTD
		lineageTag: d2d14057-1be0-4b7a-b506-2c44759b124b

	measure 'Avvik YTD' = [Actual YTD] - [Budsjett YTD]
		formatString: #,##0.00
		displayFolder: _01 Regnskap & YTD
		lineageTag: 0ff91b01-5b4c-4f40-b058-3dc8ea09ca28

	measure 'Avvik YTD %' = DIVIDE([Avvik YTD], ABS([Budsjett YTD]), 0)
		formatString: 0.0%
		displayFolder: _01 Regnskap & YTD
		lineageTag: 2bfac7e3-fadc-4a1c-bd51-57da5f449113

	measure 'Forecast Q4' =
			CALCULATE(
			    SUM('FactGL'[Belop_signert_MNOK]),
			    'FactGL'[VersjonKode] = "FC_Q4_2026"
			)
		formatString: #,##0.00
		displayFolder: _02 Prognose & EAC
		lineageTag: 36dc4908-a34b-4de3-a7c5-d25ca5518a64

	measure 'Forecast LE (EAC)' = [Actual YTD] + [Forecast Q4]
		formatString: #,##0.00
		displayFolder: _02 Prognose & EAC
		lineageTag: 079f2a17-de7c-4668-bcbe-80078d8cfd3d

	measure 'Årsbudsjett (BAC)' = SUM('FactBudget'[Budsjett_signert_MNOK])
		formatString: #,##0.00
		displayFolder: _02 Prognose & EAC
		lineageTag: 9ec6de9c-d89c-4b54-b667-5b1c12547173

	measure 'Sluttavvik (VAC)' = [Årsbudsjett (BAC)] - [Forecast LE (EAC)]
		formatString: #,##0.00
		displayFolder: _02 Prognose & EAC
		lineageTag: 967706d9-0852-402e-a49e-b1803bf57443

	measure 'VAC %' = DIVIDE([Sluttavvik (VAC)], ABS([Årsbudsjett (BAC)]), 0)
		formatString: 0.0%
		displayFolder: _02 Prognose & EAC
		lineageTag: 693b30b3-332f-4701-9a1f-e837b2696f32

	measure 'Planned Value (PV)' = SUM('FactEVM'[Planned_Value_PV_MNOK])
		formatString: #,##0.0
		displayFolder: _03 EVM
		lineageTag: 003851e0-8cdf-4732-973c-2eb8075fdb22

	measure 'Earned Value (EV)' = SUM('FactEVM'[Earned_Value_EV_MNOK])
		formatString: #,##0.0
		displayFolder: _03 EVM
		lineageTag: 096ebe8b-d998-46d3-a9bc-6d3b521dc250

	measure 'Actual Cost (AC)' = SUM('FactEVM'[Actual_Cost_AC_MNOK])
		formatString: #,##0.0
		displayFolder: _03 EVM
		lineageTag: 7f55e474-1953-4a6c-b866-1240d8f1daac

	measure 'CPI' = DIVIDE([Earned Value (EV)], [Actual Cost (AC)], 1)
		formatString: 0.00
		displayFolder: _03 EVM
		lineageTag: 5bd45195-1566-4100-8426-c6117ef4b632

	measure 'SPI' = DIVIDE([Earned Value (EV)], [Planned Value (PV)], 1)
		formatString: 0.00
		displayFolder: _03 EVM
		lineageTag: 87260a1c-f390-4367-856b-a037aa1ca10b

	measure 'Totale Årsverk' =
			CALCULATE(
			    SUM('FactFTE'[Aarsverk_Faktisk]),
			    'DimDate'[DatoNokkel] = MAX('FactFTE'[DatoNokkel])
			)
		formatString: #,##0.0
		displayFolder: _04 Bemanning & FTE
		lineageTag: 2f36eb8a-db03-4393-a569-d204061b5ba1

	measure 'Faglige Årsverk (UF)' =
			CALCULATE(
			    SUM('FactFTE'[Aarsverk_UF]),
			    'DimDate'[DatoNokkel] = MAX('FactFTE'[DatoNokkel])
			)
		formatString: #,##0.0
		displayFolder: _04 Bemanning & FTE
		lineageTag: 5bf84158-4237-4026-b6f0-39b3261baa46

	measure 'Teknisk-Admin Årsverk (TA)' =
			CALCULATE(
			    SUM('FactFTE'[Aarsverk_TA]),
			    'DimDate'[DatoNokkel] = MAX('FactFTE'[DatoNokkel])
			)
		formatString: #,##0.0
		displayFolder: _04 Bemanning & FTE
		lineageTag: 4ac505e6-d3ed-483e-858a-071d64d5ef28

	measure 'Faglig Andel %' = DIVIDE([Faglige Årsverk (UF)], [Totale Årsverk], 0)
		formatString: 0.0%
		displayFolder: _04 Bemanning & FTE
		lineageTag: 41e1a78f-657e-4120-9332-6166abf5eacc

	measure 'Registrerte Studenter' = SUM('FactStudents'[Registrerte_Studenter])
		formatString: #,##0
		displayFolder: _05 Utdanning
		lineageTag: f7ab4022-c16b-446a-8f4f-372f0b1c44e4

	measure 'Avlagte SPE60' = SUM('FactStudents'[SPE60_Helarsstudenter])
		formatString: #,##0.0
		displayFolder: _05 Utdanning
		lineageTag: 1673961b-ff27-48fe-bdba-bfa0f6299a19

	measure 'Studenter pr UF-Årsverk' = DIVIDE([Registrerte Studenter], [Faglige Årsverk (UF)], 0)
		formatString: #,##0.0
		displayFolder: _05 Utdanning
		lineageTag: de6d7b0a-d51c-41cb-8ec0-f4a402770528

	measure 'Enhetskostnad pr SPE60' = DIVIDE([Forecast LE (EAC)] * 1000000, [Avlagte SPE60], 0)
		formatString: #,##0
		displayFolder: _05 Utdanning
		lineageTag: d1d060be-fbb5-4dab-bf41-9b349dade131

	measure 'KD Resultatbevilgning MNOK' =
			VAR Kat1 = SUM('FactStudents'[KD_Kategori1_SPE60]) * 54550
			VAR Kat2 = SUM('FactStudents'[KD_Kategori2_SPE60]) * 81800
			VAR Kat3 = SUM('FactStudents'[KD_Kategori3_SPE60]) * 190900
			RETURN DIVIDE(Kat1 + Kat2 + Kat3, 1000000, 0)
		formatString: #,##0.00
		displayFolder: _05 Utdanning
		lineageTag: ce151c21-de7c-477c-9b7f-ca74cd6d0d9f

	measure 'Forecast RAG Status' =
			IF([Sluttavvik (VAC)] >= 0, "🟢 Under/I budsjett",
			    IF([VAC %] >= -0.05, "🟡 Moderat overskridelse (< 5%)",
			        "🔴 Kritisk overskridelse (> 5%)"
			    )
			)
		displayFolder: _06 RAG & Design
		lineageTag: a4944328-169f-4d33-bd76-550216a922e7

	measure 'RAG Hex Color' =
			IF([Sluttavvik (VAC)] >= 0, "#10b981",
			    IF([VAC %] >= -0.05, "#f59e0b",
			        "#ef4444"
			    )
			)
		displayFolder: _06 RAG & Design
		lineageTag: 39287350-ba51-4375-910d-9dfeacab4351

	partition _Measures = m
		mode: import
		source =
			let
			    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
			    #"Removed Columns" = Table.RemoveColumns(Source,{{"Column1"}})
			in
			    #"Removed Columns"

	annotation PBI_ResultType = Table
