		lineageTag: b8a12355-0de1-43b4-8a30-4aff406f9683

	measure '5% Regel Status' = IF([Ubenyttede Midler %] <= 0.05, "🟢 Innenfor 5% (F-05-20)", "🔴 Risiko for inndragning (>5%)")
		displayFolder: _07 RAG & Design
		lineageTag: b8a12356-0de1-43b4-8a30-4aff406f9684

	measure 'Aktiv Enhet' =
