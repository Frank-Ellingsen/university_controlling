{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "vis4_cht_month_profile",
  "position": {
    "x": 20,
    "y": 680,
    "z": 40,
    "width": 930,
    "height": 370,
    "tabOrder": 10
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimDate"
                    }
                  },
                  "Property": "MaanedNavn"
                }
              },
              "queryRef": "DimDate.MaanedNavn",
              "nativeQueryRef": "Måned",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Actual YTD"
                }
              },
              "queryRef": "_Measures.Actual YTD",
              "nativeQueryRef": "Faktisk kostnad YTD"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Budsjett YTD"
                }
              },
              "queryRef": "_Measures.Budsjett YTD",
              "nativeQueryRef": "Budsjett YTD"
            }
          ]
        }
      }
    },
    "objects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Månedlig Kostnadsprofil vs Budsjett (MNOK)'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
